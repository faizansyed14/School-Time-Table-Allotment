# Backend (FastAPI) environment reference — see .env.dev / .env.prod for full stacks.

# Database — the single switch (docker / AWS RDS / Supabase)
DATABASE_URL=postgresql://erp:erp_password@localhost:5432/school_erp
# Or provide parts instead of a URL:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=school_erp
# DB_USER=erp
# DB_PASSWORD=erp_password
# DB_SSLMODE=require   # set for AWS RDS / Supabase

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_HOURS=7
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
AUTO_INIT_DB=true
SEED_DEMO_DATA=false

# Captcha
CAPTCHA_LENGTH=6
CAPTCHA_TTL_SECONDS=300

# Rate limiting
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_CAPTCHA=30/minute

# Solver
SOLVER_TIME_LIMIT=60
SOLVER_WORKERS=8
SAME_PERIOD_CONSISTENCY=true

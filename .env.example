# ============================================================
# School ERP — environment template (Docker only)
# Copy to .env.dev or .env.prod and edit secrets before starting.
#
#   cp .env.example .env.dev    →  ./scripts/dev/start.sh
#   cp .env.example .env.prod   →  ./scripts/prod/start.sh
# ============================================================

# ── Database: the SINGLE switch ─────────────────────────────
# Point DATABASE_URL at the bundled docker Postgres (default),
# AWS RDS, or Supabase — nothing else in the app changes.
DB_PROVIDER=postgres
DATABASE_URL=postgresql://erp:CHANGE_ME_DB_PASSWORD@db:5432/school_erp
# AWS RDS  : postgresql://USER:PASS@your-instance.xxxxx.rds.amazonaws.com:5432/school_erp?sslmode=require
# Supabase : postgresql://postgres:PASS@db.YOURREF.supabase.co:5432/postgres

# Credentials for the bundled Postgres container (db service)
POSTGRES_DB=school_erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_HOURS=7
# Seed admin (created automatically on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# ── App ─────────────────────────────────────────────────────
# development | production
NODE_ENV=development
PORT=4000
# Comma-separated allowed frontend origins (production: your public URL)
CORS_ORIGIN=http://localhost:3000
AUTO_INIT_DB=true
# true for local demo data; false in production
SEED_DEMO_DATA=false

# ── Captcha ─────────────────────────────────────────────────
CAPTCHA_LENGTH=6
CAPTCHA_TTL_SECONDS=300

# ── Rate limiting ───────────────────────────────────────────
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_CAPTCHA=30/minute

# ── Solver ──────────────────────────────────────────────────
SOLVER_TIME_LIMIT=60
SOLVER_WORKERS=4
# Best-effort: keep the same teacher/subject in the same period every day
SAME_PERIOD_CONSISTENCY=true

# ── Ports / Frontend ────────────────────────────────────────
BACKEND_PORT=4000
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:4000
